{
  "name": "itty-time",
  "version": "2.0.1",
  "description": "Smaller and faster than ms.",
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs"
    },
    "./datePlus": {
      "import": "./dist/datePlus.mjs",
      "types": "./dist/datePlus.d.ts",
      "require": "./dist/datePlus.cjs"
    },
    "./duration": {
      "import": "./dist/duration.mjs",
      "types": "./dist/duration.d.ts",
      "require": "./dist/duration.cjs"
    },
    "./ms": {
      "import": "./dist/ms.mjs",
      "types": "./dist/ms.d.ts",
      "require": "./dist/ms.cjs"
    },
    "./seconds": {
      "import": "./dist/seconds.mjs",
      "types": "./dist/seconds.d.ts",
      "require": "./dist/seconds.cjs"
    }
  },
  "scripts": {
    "dev": "bun test --watch --coverage",
    "test": "bun test --coverage",
    "lint": "itty lint",
    "build": "itty lint && itty build --hybrid",
    "release": "itty release --prepare --tag --push",
    "release:next": "itty release --prepare --tag --push --type=next"
  },
  "keywords": [
    "humanize",
    "duration",
    "ttl",
    "ms",
    "months",
    "time",
    "dates",
    "string",
    "readable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwhitley/itty-time.git"
  },
  "author": "Kevin R. Whitley <krwhitley@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/kwhitley/itty-time/issues"
  },
  "devDependencies": {
    "@types/bun": "^1.2.17",
    "itty-packager": "^1.6.7"
  }
}
